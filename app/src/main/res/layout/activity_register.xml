<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/ic_custom_shield" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create Account"
        android:textColor="@color/brand_dark_blue"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="Get started with Elite Guard protection"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <!-- 1. FULL NAME INPUT FIELD -->
    <EditText
        android:id="@+id/etFullName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_filled_button"
        android:backgroundTint="@color/card_bg"
        android:elevation="1dp"
        android:hint="Full Name"
        android:inputType="textPersonName"
        android:paddingHorizontal="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:textSize="15sp" />

    <!-- 2. EMAIL INPUT FIELD -->
    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_filled_button"
        android:backgroundTint="@color/card_bg"
        android:elevation="1dp"
        android:hint="Email Address"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:textSize="15sp" />

    <!-- 3. PASSWORD INPUT FIELD -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_filled_button"
        android:backgroundTint="@color/card_bg"
        android:elevation="1dp"
        android:hint="Password (min 6 chars)"
        android:inputType="textPassword"
        android:paddingHorizontal="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:textSize="15sp" />

    <!-- 4. SIGN UP BUTTON -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSignUp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_filled_button"
        android:text="Sign Up"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 5. BACK BUTTON -->
    <Button
        android:id="@+id/btnBack"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back to Home"
        android:textColor="@color/brand_dark_blue"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
